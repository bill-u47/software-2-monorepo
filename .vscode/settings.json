    "markdown-pdf.format": "Letter",
    "markdown-pdf.outputDirectory": "",
    "markdown-pdf.highlightStyle": "a11y-light.css",
    "markdown-pdf.styles": [
        ".vscode/markdown.css"
    ],
    "print.sourcecode.colourScheme": "A11 Y",
    "java.debug.settings.onBuildFailureProceed": true,
    "java.project.referencedLibraries": [
        "lib/binary-tree-utility.jar",
        "lib/BWClient.jar",
        "lib/BWServer.jar",
        "lib/components.jar",
        "lib/hamcrest-core-1.3.jar",
